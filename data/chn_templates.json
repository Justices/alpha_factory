  {
    "id": "chn_T6",
    "name": "decay_difference",
    "title": "衰减差异模板",
    "family": "chn_mined",
    "template_type": "placeholder",
    "expression_template": "signed_power(ts_decay_linear(vec_avg(<field>), <w1>) - ts_decay_exp_windows(vec_avg(<field>), <w2>, factor=<factor>), <power>)",
    "template_index": 6,
    "fields_per_alpha": 1,
    "expression_origin": "chn_analyst_pattern",
    "field_types": ["VECTOR"],
    "categories": ["analyst", "sentiment"],
    "placeholders": {
      "field": {"role": "scalar", "type": "data_field", "field_type": "VECTOR"},
      "w1": {"role": "parameter", "type": "integer", "allowed_values": [63, 126, 252], "default": 126, "description": "短窗口"},
      "w2": {"role": "parameter", "type": "integer", "allowed_values": [252, 500], "default": 252, "description": "长窗口"},
      "factor": {"role": "parameter", "type": "float", "allowed_values": [0.90, 0.95, 0.99], "default": 0.95, "description": "指数衰减因子"},
      "power": {"role": "parameter", "type": "float", "allowed_values": [0.5, 1.0, 2.0], "default": 0.5, "description": "signed_power指数"}
    },
    "group_slots": [],
    "slot_count": 5,
    "description": "短窗口线性衰减与长窗口指数衰减的差异，捕捉动量变化率",
    "rationale": "衰减差异 = 短窗口动量 - 长窗口动量，反映动量的加速度",
    "example_expression": "signed_power(ts_decay_linear(vec_avg(analyst_field), 126) - ts_decay_exp_windows(vec_avg(analyst_field), 252, factor=0.95), 0.5)",
    "settings_hint": {"region": "CHN验证通过"},
    "operators_used": ["vec_avg", "ts_decay_linear", "ts_decay_exp_windows", "signed_power"],
    "source": {"type": "region_pattern", "region": "CHN", "category": "analyst"},
    "active": 1
  },
